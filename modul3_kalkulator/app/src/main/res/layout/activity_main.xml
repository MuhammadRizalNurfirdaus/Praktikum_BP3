<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context="com.pab.kalkulatorbangunruang.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:text="@string/app_name"
        android:layout_margin="20dp"/>

    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btn_persegi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_purple"
            android:textColor="@android:color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Persegi"
            android:textAllCaps="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:gravity="center"
            android:elevation="4dp"
            android:contentDescription="Tombol Persegi" />

        <Button
            android:id="@+id/btn_segitiga"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_purple"
            android:textColor="@android:color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Segitiga"
            android:textAllCaps="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:gravity="center"
            android:elevation="4dp"
            android:contentDescription="Tombol Segitiga" />

        <Button
            android:id="@+id/btn_persegi_panjang"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_purple"
            android:textColor="@android:color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Persegi Panjang"
            android:textAllCaps="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:gravity="center"
            android:elevation="4dp"
            android:contentDescription="Tombol Persegi Panjang" />

        <Button
            android:id="@+id/btn_lingkaran"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/rounded_purple"
            android:textColor="@android:color/white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Lingkaran"
            android:textAllCaps="false"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:gravity="center"
            android:elevation="4dp"
            android:contentDescription="Tombol Lingkaran" />

    </LinearLayout>

</LinearLayout>