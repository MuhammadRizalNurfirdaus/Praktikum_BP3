<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aplikasi_Data_Mahasiswa">
        <activity
            android:name=".ui.TentangActivity"
            android:exported="false"
            android:label="@string/title_tentang" />
        
        <activity
            android:name=".ui.StatistikActivity"
            android:exported="false"
            android:label="@string/title_statistik" />

        <activity
            android:name=".ui.TambahMahasiswaActivity"
            android:exported="false"
            android:label="@string/title_tambah_mahasiswa" />

        <activity
            android:name=".ui.DataMahasiswaActivity"
            android:exported="false"
            android:label="@string/title_data_mahasiswa" />
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:label="Profil" />
        <activity
            android:name=".ui.PengaturanActivity"
            android:exported="false"
            android:label="Pengaturan" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>