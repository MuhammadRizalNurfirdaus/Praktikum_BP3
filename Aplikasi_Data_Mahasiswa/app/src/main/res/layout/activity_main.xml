<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Judul Dashboard -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Aplikasi"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Tombol Menu 1 -->
    <Button
        android:id="@+id/btnMenu1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Profil"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Menu 2 -->
    <Button
        android:id="@+id/btnMenu2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Data Mahasiswa"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnMenu1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Menu 3 -->
    <Button
        android:id="@+id/btnMenu3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pengaturan"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnMenu2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tombol Menu 4 -->
    <Button
        android:id="@+id/btnMenu4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnMenu3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
